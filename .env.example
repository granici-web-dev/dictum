ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_DECOMPOSE=claude-sonnet-5
# Потолок одного ответа модели. Умолчания хватает на разбор двухчасовой встречи — самой
# длинной записи, которую система принимает, — и трогать эту строку для часовых созвонов не надо.
# Выше 128000 не ставится: столько claude-sonnet-5 отдаёт за ответ, и бот с большим не стартует.
ANTHROPIC_MAX_TOKENS=64000
# Живые вызовы API тратят ваш ключ. true ставится на один осознанный прогон.
ALLOW_LIVE_API=false
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Чьи сообщения бот обслуживает: id через запятую, у групп они отрицательные. Свой id покажет
# @userinfobot. Пусто — бот не запускается: имя бота публично, и без списка любой найденный
# им человек тратит ваш ключ.
TELEGRAM_ALLOWED_CHAT_IDS=
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Отдельная доска для пути «своя идея»: туда ложатся фазы и задачи, а TRELLO_BOARD_ID остаётся
# для карточек поручений. Пусто — кнопка «Проработать как идею» отказывает сразу, ничего не тратя.
TRELLO_IDEA_BOARD_ID=
# Префикс сквозных ключей задач: DCT-1, DCT-2 … Заглавные латинские, 2-10 знаков.
PROJECT_KEY=DCT
DATABASE_URL=postgresql+psycopg://dictum:dictum@localhost:5434/dictum
DEFAULT_LANG=de
# Язык, на котором вы читаете разбор встречи. Сказанное на встрече идёт в оригинале, рядом
# перевод на этот язык, если запись на другом.
OWNER_LANG=ru
KEEP_AUDIO=false
# Ворота после brief и decompose: true снимает их и гонит прогон до карточек без подтверждений.
# Быстрый режим для себя, включается явно. Это умолчание для
# новых чатов: в самом чате его перебивает /gates on|off, до перезапуска бота.
AUTO_APPROVE=false
# Сколько вопросов бриф задаёт в диалоге, прежде чем собрать его из того, что есть.
# Каждый вопрос — вызов модели и круг ожидания человека.
MAX_BRIEF_QUESTIONS=5
# Стандарты рабочего проекта для пути поручения: корень рабочего репозитория или каталог, где
# лежат STACK.md, PRINCIPLES.md, TESTING.md от /rigorous document. Абсолютный путь или ~/…
# Файлы уходят в Anthropic входом стадий и в git этого репозитория не попадают. Пусто: стандартов нет.
PROJECT_CONTEXT_DIR=
# Папка на этой машине, куда вы кладёте записи созвонов: бот сам замечает файл и спрашивает про
# согласие и цену в чате. Абсолютный путь или ~/… Работает при ровно одном чате в списке выше;
# при нескольких запись отдаётся командой make meeting FILE=… CHAT=<id>. Пусто — за папкой никто
# не следит. Заданная папка обязана существовать, иначе бот не стартует.
MEETING_INBOX_DIR=
# Диагностика: класть ли рядом с артефактами outputs/<стадия>.trace.json — типы блоков ответа
# и usage по каждому вызову модели, без содержимого и без ключей. Нужен, когда стадия ответила
# не тем, чем должна была: сырой ответ удачной стадии нигде не остаётся.
TRACE_STAGE_CALLS=false
