ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_DECOMPOSE=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16000
# Живые вызовы API тратят ваш ключ. true ставится на один осознанный прогон.
ALLOW_LIVE_API=false
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Префикс сквозных ключей задач: DCT-1, DCT-2 … Заглавные латинские, 2-10 знаков.
PROJECT_KEY=DCT
DATABASE_URL=postgresql+psycopg://i2b:i2b@localhost:5432/i2b
REDIS_URL=redis://localhost:6379/0
DEFAULT_LANG=de
KEEP_AUDIO=false
