ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_DECOMPOSE=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=24000
# Живые вызовы API тратят ваш ключ. true ставится на один осознанный прогон.
ALLOW_LIVE_API=false
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Чьи сообщения бот обслуживает: id через запятую, у групп они отрицательные. Свой id покажет
# @userinfobot. Пусто — бот не запускается: имя бота публично, и без списка любой найденный
# им человек тратит ваш ключ.
TELEGRAM_ALLOWED_CHAT_IDS=
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Префикс сквозных ключей задач: DCT-1, DCT-2 … Заглавные латинские, 2-10 знаков.
PROJECT_KEY=DCT
DATABASE_URL=postgresql+psycopg://dictum:dictum@localhost:5434/dictum
DEFAULT_LANG=de
KEEP_AUDIO=false
